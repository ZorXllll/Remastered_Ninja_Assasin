-- Scan for stat object
_G.LocalTracker.Utils.scanForStatFast = function(player, statName)
    if not player then return nil end
    local lowerTarget = string.lower(statName):gsub("%s+", "")

    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, child in ipairs(leaderstats:GetChildren()) do
            local cleanName = string.lower(child.Name):gsub("%s+", "")
            if cleanName == lowerTarget or string.find(cleanName, lowerTarget) then
                if child:IsA("ValueBase") then return child end
            end
        end
    end

    local char = player.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            local cleanName = string.lower(child.Name):gsub("%s+", "")
            if cleanName == lowerTarget or string.find(cleanName, lowerTarget) then
                if child:IsA("ValueBase") then return child end
            end
        end
    end

    for _, child in ipairs(player:GetChildren()) do
        local cleanName = string.lower(child.Name):gsub("%s+", "")
        if (cleanName == lowerTarget or string.find(cleanName, lowerTarget)) and child:IsA("ValueBase") then
            return child
        end
    end

    local function deepSearch(parent, depth)
        if depth > 3 then return nil end
        for _, child in ipairs(parent:GetChildren()) do
            local cleanName = string.lower(child.Name):gsub("%s+", "")
            if (cleanName == lowerTarget or string.find(cleanName, lowerTarget)) and child:IsA("ValueBase") then
                return child
            end
            if child:IsA("Folder") or child:IsA("Configuration") or child:IsA("Model") then
                local found = deepSearch(child, depth + 1)
                if found then return found end
            end
        end
        return nil
    end

    return deepSearch(player, 1)
end

-- Compute + render (same calculation as reference)
_G.LocalTracker.Utils.computeAndRenderStat = function(name, currentVal)
    local currentTime = tick()
    local startVal = _G.LocalTracker.StartStats[name]

    if not startVal then
        _G.LocalTracker.StartStats[name] = currentVal
        startVal = currentVal
        _G.LocalTracker.TotalGained[name] = 0
        _G.LocalTracker.LastValues[name] = currentVal
        _G.LocalTracker.LastUpdates[name] = currentTime
        _G.LocalTracker.Rates[name] = 0
    end

    _G.LocalTracker.TotalGained[name] = _G.LocalTracker.TotalGained[name] or 0
    _G.LocalTracker.LastValues[name] = _G.LocalTracker.LastValues[name] or currentVal
    _G.LocalTracker.LastUpdates[name] = _G.LocalTracker.LastUpdates[name] or currentTime
    _G.LocalTracker.Rates[name] = _G.LocalTracker.Rates[name] or 0

    -- Reset detection
    if currentVal < _G.LocalTracker.LastValues[name] then
        local progressBeforeReset = math.max(_G.LocalTracker.LastValues[name] - _G.LocalTracker.StartStats[name], 0)
        _G.LocalTracker.TotalGained[name] = _G.LocalTracker.TotalGained[name] + progressBeforeReset
        _G.LocalTracker.StartStats[name] = currentVal
        startVal = currentVal
    end

    local diff = currentVal - _G.LocalTracker.LastValues[name]
    local timePassed = currentTime - _G.LocalTracker.LastUpdates[name]

    if timePassed >= 0.1 then
        if diff > 0 then
            local instantRate = diff / timePassed
            _G.LocalTracker.Rates[name] = (_G.LocalTracker.Rates[name] == 0) and instantRate or ((_G.LocalTracker.Rates[name] * 0.7) + (instantRate * 0.3))
        else
            if timePassed > 2 then
                _G.LocalTracker.Rates[name] = _G.LocalTracker.Rates[name] * 0.85
                if _G.LocalTracker.Rates[name] < 0.1 then _G.LocalTracker.Rates[name] = 0 end
            end
        end
        _G.LocalTracker.LastUpdates[name] = currentTime
    end

    _G.LocalTracker.LastValues[name] = currentVal

    local currentGain = math.max(currentVal - startVal, 0)
    local gained = _G.LocalTracker.TotalGained[name] + currentGain
    local formattedCurrent = formatNum(currentVal)
    local activeRate = _G.LocalTracker.Rates[name] or 0

    if gained > 0 and activeRate > 0 then
        _G.LocalTracker.Utils.updateLabelText(_G.LocalTracker.Labels[name], string.format(
            "%s: %s (+%s) | M: %s | H: %s | D: %s | W: %s",
            name, formattedCurrent, formatNum(gained),
            formatNum(activeRate * 60),
            formatNum(activeRate * 3600),
            formatNum(activeRate * 86400),
            formatNum(activeRate * 604800)
        ))
    else
        _G.LocalTracker.Utils.updateLabelText(_G.LocalTracker.Labels[name], string.format("%s: %s (+0) | M: 0 | H: 0 | D: 0 | W: 0", name, formattedCurrent))
    end
end

-- Bind object signals
_G.LocalTracker.Utils.bindObjectSignals = function(name, obj)
    _G.LocalTracker.CachedObjects[name] = obj

    local initialVal = tonumber(obj.Value) or 0
    if not _G.LocalTracker.StartStats[name] or _G.LocalTracker.StartStats[name] == 0 then
        _G.LocalTracker.StartStats[name] = initialVal
    end

    _G.LocalTracker.LastValues[name] = initialVal
    _G.LocalTracker.TotalGained[name] = _G.LocalTracker.TotalGained[name] or 0
    _G.LocalTracker.LastUpdates[name] = tick()
    _G.LocalTracker.Rates[name] = 0

    if _G.LocalTracker.Connections[name] then
        pcall(function() _G.LocalTracker.Connections[name]:Disconnect() end)
    end

    _G.LocalTracker.Connections[name] = obj.Changed:Connect(function(newVal)
        _G.LocalTracker.Utils.computeAndRenderStat(name, tonumber(newVal) or 0)
    end)

    _G.LocalTracker.Utils.computeAndRenderStat(name, initialVal)
end

