-- Spy loop (same calculation)
task.spawn(function()
    while task.wait(0.5) do
        local currentTime = tick()
        local S = _G.SpyCore.SpyState

        if S.target and S.target.Parent == Players then
            for _, name in ipairs(_G.LocalTracker.Config.Stats) do
                local statObj = _G.LocalTracker.Utils.scanForStatFast(S.target, name)
                local labelObj = S.labels[name]

                if statObj and labelObj then
                    local currentVal = tonumber(statObj.Value) or 0
                    if not S.start[name] then
                        S.start[name], S.last[name], S.total[name], S.ticks[name], S.rate[name] = currentVal, currentVal, 0, currentTime, 0
                    end

                    -- Reset detection
                    if currentVal < S.last[name] then
                        S.total[name] = S.total[name] + math.max(S.last[name] - S.start[name], 0)
                        S.start[name] = currentVal
                    end

                    local diff = currentVal - S.last[name]
                    local timePassed = currentTime - S.ticks[name]

                    if timePassed >= 0.1 then
                        if diff > 0 then
                            local instantRate = diff / timePassed
                            S.rate[name] = (S.rate[name] == 0) and instantRate or ((S.rate[name] * 0.7) + (instantRate * 0.3))
                            S.ticks[name] = currentTime
                        else
                            if timePassed > 2 then
                                S.rate[name] = (S.rate[name] or 0) * 0.85
                                if S.rate[name] < 0.1 then S.rate[name] = 0 end
                            end
                        end
                    end
                    S.last[name] = currentVal

                    local gained = S.total[name] + math.max(currentVal - S.start[name], 0)
                    local r = S.rate[name] or 0

                    if gained > 0 and r > 0 then
                        _G.LocalTracker.Utils.updateLabelText(labelObj, string.format(
                            "%s: %s (+%s) | M: %s | H: %s | D: %s | W: %s",
                            name, formatNum(currentVal), formatNum(gained),
                            formatNum(r * 60),
                            formatNum(r * 3600),
                            formatNum(r * 86400),
                            formatNum(r * 604800)
                        ))
                    else
                        _G.LocalTracker.Utils.updateLabelText(labelObj, string.format("%s: %s (+0) | M: 0 | H: 0 | D: 0 | W: 0", name, formatNum(currentVal)))
                    end
                end
            end
        else
            for _, name in ipairs(_G.LocalTracker.Config.Stats) do
                if S.labels[name] then
                    _G.LocalTracker.Utils.updateLabelText(S.labels[name], name .. ": N/A (+0) | M: 0 | H: 0 | D: 0 | W: 0")
                end
            end
        end
    end
end)

