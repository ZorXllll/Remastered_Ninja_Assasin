local function formatNum(v)
    if not v then return "0" end
    if v >= 1e18 then return string.format("%.2fQi", v/1e18)
    elseif v >= 1e15 then return string.format("%.2fQa", v/1e15)
    elseif v >= 1e12 then return string.format("%.2fT", v/1e12)
    elseif v >= 1e9 then return string.format("%.2fB", v/1e9)
    elseif v >= 1e6 then return string.format("%.2fM", v/1e6)
    elseif v >= 1e3 then return string.format("%.2fK", v/1e3)
    else return tostring(math.floor(v)) end
end

local function formatPace(perSecond)
    if not perSecond or perSecond <= 0 then
        return "--/s | --/min | --/h | --/d | --/w"
    end
    return formatNum(perSecond) .. "/s | "
        .. formatNum(perSecond * 60) .. "/min | "
        .. formatNum(perSecond * 3600) .. "/h | "
        .. formatNum(perSecond * 86400) .. "/d | "
        .. formatNum(perSecond * 604800) .. "/w"
end

